# Google Analytics 4 Measurement ID (public identifier, not a secret). Leave empty to disable analytics.
VITE_GA_MEASUREMENT_ID=
# Set to true to send events from `npm run dev` (shows in GA4 DebugView).
VITE_GA_DEBUG=false

# Supabase content, read at build time only (public values). Without them, use: npm run content:fetch -- --from-backup
# Project Settings > API: the project URL and the *publishable* key (sb_publishable_...). Never a secret/service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

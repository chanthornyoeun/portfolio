# Copy to .env.local for local overrides. Never commit real values.
# This is a static site: every NEXT_PUBLIC_ value ends up in the published files.

# Public URL of the site, including the repository path for a GitHub Pages project site:
#   https://<user>.github.io/<repo>   (project site; base path becomes /<repo>)
#   https://<user>.github.io          (user site)
#   https://example.com               (custom domain)
# Defaults to http://localhost:3000. In GitHub Actions it comes from actions/configure-pages.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set only by the deploy workflow; makes the build require an https site URL.
# DEPLOY_ENV=production

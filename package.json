{
  "name": "my-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run content:fetch && npm run build:site",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test tests/*.test.ts",
    "seed:generate": "node scripts/generate-seed.ts",
    "content:fetch": "node scripts/fetch-content.ts",
    "build:local": "npm run content:fetch -- --from-backup && npm run build:site",
    "build:site": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.ts",
    "predev": "node scripts/fetch-content.ts",
    "og:generate": "node scripts/generate-og-image.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^0.487.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.7.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
